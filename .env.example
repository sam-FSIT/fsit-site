# Clé Resend limitée à l'envoi d'e-mails. Ne pas réutiliser celle du portail.
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_EMAIL=contact@fullstack-it.fr
# Adresse d'expédition : doit appartenir à un domaine vérifié dans Resend.
# Reprendre la valeur déjà utilisée par le portail.
RESEND_FROM_EMAIL=
